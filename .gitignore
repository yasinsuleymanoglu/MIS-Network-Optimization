*.so

# 3. Sanal Ortamlar (Kütüphanelerin github'a gitmesini engeller)
venv/
.venv/
env/
.env/

# 4. Jupyter Notebook Gizli Dosyaları
.ipynb_checkpoints/
*.ipynb_checkpoints/
